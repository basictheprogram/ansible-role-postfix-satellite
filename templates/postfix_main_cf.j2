smtpd_banner = $myhostname ESMTP $mail_name 
biff = no
append_dot_mydomain = no
readme_directory = no

myhostname = {{ postfix_myhostname }}
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
myorigin = {{ postfix_myorigin }}
{% if postfix_mydestination is defined %}
mydestination = {{ postfix_mydestination }}
{% else %}
mydestination = {{ postfix_myhostname }}, localhost
{% endif %}
{% if postfix_relayhost is defined  %}
relayhost = [{{ postfix_relayhost | default("") }}]
{% else %}
relayhost =
{% endif %}
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = loopback-only
inet_protocols = {{ postfix_inet_protocols | default("all") }}
compatibility_level = {{ postfix_compatibility_level | default("0") }}
{% if postfix_lmtp_host_lookup is defined %}
lmtp_host_lookup = native
{% endif %}
{% if postfix_smtp_host_lookup is defined %}
smtp_host_lookup = native
{% endif %}

{% if ansible_os_family == "Suse" %}
# suse specific parameter
setgid_group = maildrop
daemon_directory = /usr/lib/postfix
{% endif %}
